module: "vendor.lineage.slider.SliderProperties"
owner: Vendor

# Where the position is read from. An axis takes it from the input device
# itself, while a node takes it from a file the device reports changes to
# without saying what they are. Left out, it is the axis.
prop {
    api_name: "backend"
    type: Enum
    enum_values: "axis|node"
    scope: Internal
    access: Readonly
    prop_name: "ro.vendor.slider.backend"
}

# Names of the input device the slider reports on, in the order they are
# tried, so that one device tree can name several.
prop {
    api_name: "input_name"
    type: StringList
    scope: Internal
    access: Readonly
    prop_name: "ro.vendor.slider.input_name"
}

# The absolute axis the slider reports its position on, as the decimal
# value of an EV_ABS code.
prop {
    api_name: "code"
    type: Integer
    scope: Internal
    access: Readonly
    prop_name: "ro.vendor.slider.code"
}

# The file holding the position, for the node backend. The HAL's own
# policy cannot name this file's label, so a device adding one adds the
# rule that lets the HAL read it.
prop {
    api_name: "node"
    type: String
    scope: Internal
    access: Readonly
    prop_name: "ro.vendor.slider.node"
}

# What that file holds at each position, in travel order, so the first is
# the off end and the count is how many positions there are.
prop {
    api_name: "node_values"
    type: IntegerList
    scope: Internal
    access: Readonly
    prop_name: "ro.vendor.slider.node_values"
}

# The display edge the slider sits beside. Leaving this out, or leaving
# out the offset, leaves an indicator to place itself.
prop {
    api_name: "edge"
    type: Enum
    enum_values: "left|top|right|bottom"
    scope: Internal
    access: Readonly
    prop_name: "ro.vendor.slider.edge"
}

# The way the slider travels as the position index rises. It runs along
# the edge the slider sits beside, so left or right carries up or down,
# and top or bottom carries left or right.
prop {
    api_name: "direction"
    type: Enum
    enum_values: "up|right|down|left"
    scope: Internal
    access: Readonly
    prop_name: "ro.vendor.slider.direction"
}

# Where along that edge the middle of the slider's travel is, in pixels
# from the origin of the display in its natural orientation, at the
# largest resolution the display reports as supported.
prop {
    api_name: "offset_pixels"
    type: Integer
    scope: Internal
    access: Readonly
    prop_name: "ro.vendor.slider.offset_pixels"
}

# The display the offset is measured on, as
# android.view.Display#getUniqueId reports it. Left out, it is the
# default display.
prop {
    api_name: "display"
    type: String
    scope: Internal
    access: Readonly
    prop_name: "ro.vendor.slider.display"
}
