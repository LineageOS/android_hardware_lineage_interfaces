rust_binary {
    name: "vendor.lineage.livedisplay-service.sysfs",
    relative_install_path: "hw",
    init_rc: ["vendor.lineage.livedisplay-service.sysfs.rc"],
    vendor: true,
    rustlibs: [
        "libbinder_rs",
        "liblog_rust",
        "liblogger",
        "vendor.lineage.livedisplay-V1-rust",
    ],
    srcs: ["*.rs"],
    crate_root: "main.rs",
}
