cc_binary {
    name: "android.hardware.ir-service.lineage",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.ir-service.lineage.rc"],
    vintf_fragments: ["android.hardware.ir-service.lineage.xml"],
    cflags: select(soong_config_variable("lineage_ir", "distinct_carrier_freqs"), {
        any @ val: ["-DDISTINCT_CARRIER_FREQS" + flag_val],
        default: [],
    }),
    srcs: [
        "ConsumerIr.cpp",
        "service.cpp",
    ],
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "android.hardware.ir-V1-ndk",
    ],
}
