package vendor.lineage.input;

/**
 * Accessory types.
 */
@VintfStability
enum AccessoryType {
    /**
     * A physical keyboard.
     */
    KEYBOARD,

    /**
     * An active touchscreen pen.
     */
    ACTIVE_PEN,
}
