aidl_interface {
    name: "vendor.lineage.input",
    vendor_available: true,
    srcs: ["vendor/lineage/input/**/*.aidl"],
    stability: "vintf",
    owner: "lineage",

    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            sdk_version: "module_current",
        },
    },
}
