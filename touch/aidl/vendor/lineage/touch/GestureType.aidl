package vendor.lineage.touch;

@Backing(type="int")
@VintfStability
enum GestureType {
    TWO_FINGERS_DOWN_SWIPE,
    ONE_FINGER_UP_SWIPE,
    ONE_FINGER_UP_SWIPE_HOME,
    ONE_FINGER_DOWN_SWIPE,
    ONE_FINGER_LEFT_SWIPE,
    ONE_FINGER_RIGHT_SWIPE,
    SINGLE_TAP,
    UP_ARROW,
    DOWN_ARROW,
    LEFT_ARROW,
    RIGHT_ARROW,
    LETTER_C,
    LETTER_E,
    LETTER_O,
    LETTER_M,
    LETTER_S,
    LETTER_V,
    LETTER_W,
    LETTER_Z,
}
