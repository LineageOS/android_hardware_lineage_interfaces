// This is the expected build file, but it may not be right in all cases

aidl_interface {
    name: "vendor.lineage.powershare",
    srcs: ["vendor/lineage/powershare/*.aidl"],
    stability: "vintf",
    vendor_available: true,

    backend: {
        java: {
            enabled: true,
            platform_apis: true,
        },
        ndk: {
            enabled: true,
        },
        cpp: {
            enabled: true,
        },
    },

    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],

}
